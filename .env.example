# Required in production: absolute origin, no trailing slash. Used for metadataBase, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://ambiently.example

# Where interest-form leads go: webhook | email | console (development only) | log (CI and smoke tests only)
INTEREST_SINK=console
# INTEREST_WEBHOOK_URL=https://hooks.example.com/...
# INTEREST_WEBHOOK_SECRET=change-me
# INTEREST_NOTIFY_EMAIL=leads@ambiently.example

# HMAC secret for hashing IPs in the rate limiter. Never store raw IPs.
INTEREST_HASH_SECRET=change-me

# Rate-limit store (Upstash Redis REST). Leave unset to use the in-memory store (development only).
# RATE_LIMIT_URL=
# RATE_LIMIT_TOKEN=

# Stable Server Action encryption key for multi-instance hosting.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
